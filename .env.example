# ============================================================
# AI-Aider Environment Configuration
# ============================================================
# Copy this file to .env and uncomment the providers you use.
# Only configure the provider(s) you need — Aider auto-detects.
#
# Priority: AIDER_MODEL flag > provider-specific model > provider default

# ------------------------------------------------------------
# Ollama (local, free, private)
# ------------------------------------------------------------
# Run locally: brew install ollama && ollama serve
# Pull a model: ollama pull deepseek-coder-v2
# No API key needed — just set the base URL.
#
# OLLAMA_API_BASE=http://host.docker.internal:11434
# AIDER_MODEL=ollama/deepseek-coder-v2

# ------------------------------------------------------------
# Groq (fast cloud inference, free tier)
# ------------------------------------------------------------
# Get your key: https://console.groq.com/keys
#
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# AIDER_MODEL=groq/llama-3.3-70b-versatile

# ------------------------------------------------------------
# OpenRouter (multi-model gateway, pay-per-token)
# ------------------------------------------------------------
# Get your key: https://openrouter.ai/keys
# Browse models: https://openrouter.ai/models
#
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
# AIDER_MODEL=openrouter/anthropic/claude-sonnet-4-6

# ------------------------------------------------------------
# OpenAI (direct)
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# AIDER_MODEL=gpt-4o

# ------------------------------------------------------------
# Anthropic (direct)
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# AIDER_MODEL=claude-sonnet-4-6

# ------------------------------------------------------------
# Aider Behavior
# ------------------------------------------------------------
# Extra CLI flags passed to every aider invocation.
# Examples: --dark-mode --no-auto-commits --yes
#
# AIDER_FLAGS=

# Override the Docker image tag (default: latest)
# AIDER_TAG=latest
